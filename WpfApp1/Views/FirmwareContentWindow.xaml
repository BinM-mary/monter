<Window x:Class="WpfApp1.Views.FirmwareContentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding FileName, StringFormat='文件内容 - {0}'}"
        Width="980" Height="680" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- 样式取自 FirmwareUpgradeView 的查看器部分；本项目按“各视图自包含样式”组织，
             独立窗口复制所需样式而非引用共享字典。 -->
        <Style x:Key="ActionButtonStyle" TargetType="Button"><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="12,0" /><Setter Property="FontFamily" Value="Microsoft YaHei UI" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="#202020" /><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#BFBFBF" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#D7D7D7" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /></Style>
        <Style x:Key="SectionHeaderBarStyle" TargetType="Border"><Setter Property="Height" Value="38" /><Setter Property="BorderBrush" Value="#E7E7E7" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="VerticalAlignment" Value="Top" /></Style>
        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Microsoft YaHei UI" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#202020" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style x:Key="SectionAccentBarStyle" TargetType="Border"><Setter Property="Width" Value="3" /><Setter Property="Background" Value="#0078D4" /><Setter Property="CornerRadius" Value="2" /></Style>
        <Style x:Key="ViewerMetaTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Microsoft YaHei UI" /><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="#777777" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style x:Key="HexColumnHeaderTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Microsoft YaHei UI" /><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#777777" /><Setter Property="VerticalAlignment" Value="Center" /></Style>

        <!-- 十六进制列表：虚拟化 + 回收，行悬停浅蓝，无选中高亮 -->
        <Style x:Key="HexListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Consolas, Cascadia Code, Courier New" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F5FAFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="HexPreviewLineTemplate">
            <Grid Margin="14,0,14,0" Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="352" />
                    <ColumnDefinition Width="*" MinWidth="140" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding OffsetText}" Foreground="#888888" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding HexText}" Foreground="#286B9C" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding AsciiText}" Foreground="#777777" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- 文件内容独立窗口：与主页面共享 FirmwareUpgradeViewModel（预览行 / 摘要 / 复制命令），
         主页面加载新文件时本窗口实时刷新；关闭即销毁，不驻留后台。 -->
    <Grid Margin="12">
        <Border Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource SectionHeaderBarStyle}" Padding="18,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource SectionAccentBarStyle}" Height="18" VerticalAlignment="Center" Margin="0,0,9,0" />
                            <TextBlock Text="文件内容" Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock Text="{Binding ViewerSubTitle}" Style="{StaticResource ViewerMetaTextStyle}" Margin="10,0,0,0" />
                            <TextBlock Text="{Binding AddressRangeText}" Style="{StaticResource ViewerMetaTextStyle}" Margin="12,0,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ContentSummaryText}" Style="{StaticResource ViewerMetaTextStyle}" Margin="0,0,12,0" />
                            <Button Content="复制内容" Command="{Binding CopyContentCommand}" Style="{StaticResource ActionButtonStyle}" Height="26" Padding="10,0" FontSize="12" IsEnabled="{Binding HasPreviewContent}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#F7F7F7" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                    <Grid Margin="14,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="352" />
                            <ColumnDefinition Width="*" MinWidth="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="偏移地址" Style="{StaticResource HexColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="1" Text="十六进制数据" Style="{StaticResource HexColumnHeaderTextStyle}" />
                        <TextBlock Grid.Column="2" Text="ASCII" Style="{StaticResource HexColumnHeaderTextStyle}" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="2"
                         Style="{StaticResource HexListStyle}"
                         ItemsSource="{Binding HexPreviewLines}"
                         ItemTemplate="{StaticResource HexPreviewLineTemplate}"
                         Visibility="{Binding HasPreviewContent, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPreviewContent}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="#B1B1B1" HorizontalAlignment="Center" />
                    <TextBlock Text="暂无文件内容" FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#666666" HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="在主页面打开固件文件后，内容将在这里显示" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="#888888" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
