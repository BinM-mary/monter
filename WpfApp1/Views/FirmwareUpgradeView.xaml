<UserControl x:Class="WpfApp1.Views.FirmwareUpgradeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- 样式取值与 ActuatorDebugView 保持一致；各视图自包含样式是本项目现有组织方式，
             固件升级专属样式可在此基础上独立演化，不影响执行器调试页。 -->
        <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#D7D7D7" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /></Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button"><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="12,0" /><Setter Property="FontFamily" Value="Microsoft YaHei UI" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="#202020" /><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#BFBFBF" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}"><Setter Property="Background" Value="#0078D4" /><Setter Property="BorderBrush" Value="#0078D4" /><Setter Property="Foreground" Value="#FFFFFF" /></Style>
        <Style x:Key="ConnectionChipStyle" TargetType="Border"><Setter Property="Height" Value="32" /><Setter Property="Background" Value="#F2F2F2" /><Setter Property="BorderBrush" Value="#D5D5D5" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="10,0" /><Setter Property="Margin" Value="0,0,12,0" /></Style>
        <Style x:Key="ConnectionIndicatorStyle" TargetType="Ellipse"><Setter Property="Width" Value="8" /><Setter Property="Height" Value="8" /><Setter Property="Fill" Value="#C42B1C" /><Setter Property="VerticalAlignment" Value="Center" /><Style.Triggers><DataTrigger Binding="{Binding SerialSettings.IsConnected}" Value="True"><Setter Property="Fill" Value="#107C10" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="ConnectionStatusTextStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="#9E251A" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="7,0,10,0" /><Style.Triggers><DataTrigger Binding="{Binding SerialSettings.IsConnected}" Value="True"><Setter Property="Foreground" Value="#107C10" /></DataTrigger></Style.Triggers></Style>

        <!-- 文件信息条 -->
        <Style x:Key="FileGlyphBoxStyle" TargetType="Border"><Setter Property="Width" Value="42" /><Setter Property="Height" Value="48" /><Setter Property="Background" Value="#EEF6FB" /><Setter Property="BorderBrush" Value="#BDD2DF" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="5" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style x:Key="MetadataLabelStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#858585" /><Setter Property="Margin" Value="0,0,0,6" /></Style>
        <Style x:Key="MetadataValueStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#202020" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
        <Style x:Key="FileNameStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#202020" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding FilePath}" /><Style.Triggers><Trigger Property="Text" Value="尚未选择文件"><Setter Property="FontWeight" Value="Regular" /><Setter Property="Foreground" Value="#888888" /><Setter Property="ToolTip" Value="{x:Null}" /></Trigger></Style.Triggers></Style>

        <!-- 日志区 -->
        <Style x:Key="SectionHeaderBarStyle" TargetType="Border"><Setter Property="Height" Value="38" /><Setter Property="BorderBrush" Value="#E7E7E7" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="VerticalAlignment" Value="Top" /></Style>
        <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Microsoft YaHei UI" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#202020" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style x:Key="SectionAccentBarStyle" TargetType="Border"><Setter Property="Width" Value="3" /><Setter Property="Background" Value="#0078D4" /><Setter Property="CornerRadius" Value="2" /></Style>
        <Style x:Key="LogToolbarTextStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Microsoft YaHei UI" /><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#777777" /><Setter Property="VerticalAlignment" Value="Center" /></Style>

        <DataTemplate x:Key="FirmwareLogEntryTemplate">
            <TextBlock TextWrapping="Wrap" Margin="0,1" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12" LineHeight="19" Foreground="#D9E1E8">
                <Run Text="{Binding Time, StringFormat='HH:mm:ss', Mode=OneWay}" Foreground="#8E9EAC" /><Run Text=" [" Foreground="#8E9EAC" /><Run Text="{Binding Tag, Mode=OneWay}">
                    <Run.Style>
                        <Style TargetType="Run">
                            <Setter Property="Foreground" Value="#D9E1E8" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Success">
                                    <Setter Property="Foreground" Value="#80D49A" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                    <Setter Property="Foreground" Value="#F0C674" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                    <Setter Property="Foreground" Value="#FF9188" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Run.Style>
                </Run><Run Text="] " Foreground="#8E9EAC" /><Run Text="{Binding Message, Mode=OneWay}" Foreground="#D9E1E8" />
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 与执行器调试页同构：整页在 ScrollViewer 内随滚轮上下滚动。
         固件内容移入独立窗口（工具行“文件内容”按钮打开），页面只保留
         文件信息条、日志区与升级操作行；日志面板内部仍各自滚动。 -->
    <Grid Background="#F3F3F3">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="68" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="400" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部标题栏与串口控件：SerialSettings 为两页共享的同一实例，切换页面不打断既有串口连接。 -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="固件升级" FontFamily="Microsoft YaHei UI" FontSize="21" FontWeight="SemiBold" Foreground="#202020" />
                            <TextBlock Text="Firmware Upgrade" FontFamily="Segoe UI" FontSize="12" Foreground="#6B6B6B" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ConnectionChipStyle}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="1" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Ellipse Style="{StaticResource ConnectionIndicatorStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SerialSettings.ConnectionStatusText}" Style="{StaticResource ConnectionStatusTextStyle}" />
                                    <Border Grid.Column="2" Background="#D2D2D2" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding SerialSettings.ConnectionPortDisplayText}" FontSize="12" Foreground="#5C5C5C" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </Border>
                            <Button Content="串口设置" Command="{Binding SerialSettings.OpenCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="{Binding SerialSettings.ConnectionButtonText}" Command="{Binding SerialSettings.ToggleConnectionCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 工具行：说明 + 打开固件入口 + 文件内容独立窗口入口 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="选择固件文件，查看 HEX  原始数据" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="#777777" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="打开固件文件" Command="{Binding OpenFirmwareCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="130" />
                    <Button Grid.Column="3" Content="文件内容" Command="{Binding ShowContentCommand}" Style="{StaticResource ActionButtonStyle}" MinWidth="100" ToolTip="在独立窗口查看固件十六进制内容" />
                </Grid>

                <!-- 文件信息条：图标 + 名称 + 元数据（格式 / 映像大小 / CRC32 / 修改日期） -->
                <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                    <Grid Margin="16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource FileGlyphBoxStyle}">
                            <TextBlock Text="{Binding FileGlyph}" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#356D90" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource FileNameStyle}" Text="{Binding FileName}" />
                            <TextBlock Text="{Binding FileTypeCaption}" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="#777777" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border BorderBrush="#E6E6E6" BorderThickness="1,0,0,0" Margin="6,10,0,10">
                                <StackPanel Margin="18,0" MinWidth="96">
                                    <TextBlock Text="文件格式" Style="{StaticResource MetadataLabelStyle}" />
                                    <TextBlock Text="{Binding FormatText}" Style="{StaticResource MetadataValueStyle}" />
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="#E6E6E6" BorderThickness="1,0,0,0" Margin="0,10,0,10">
                                <StackPanel Margin="18,0" MinWidth="118">
                                    <TextBlock Text="映像大小" Style="{StaticResource MetadataLabelStyle}" />
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource MetadataValueStyle}" />
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="#E6E6E6" BorderThickness="1,0,0,0" Margin="0,10,0,10">
                                <StackPanel Margin="18,0" MinWidth="118">
                                    <TextBlock Text="校验值 CRC32" Style="{StaticResource MetadataLabelStyle}" />
                                    <TextBlock Text="{Binding ChecksumText}" Style="{StaticResource MetadataValueStyle}" />
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="#E6E6E6" BorderThickness="1,0,0,0" Margin="0,10,0,10">
                                <StackPanel Margin="18,0" MinWidth="132">
                                    <TextBlock Text="修改日期" Style="{StaticResource MetadataLabelStyle}" />
                                    <TextBlock Text="{Binding ModifiedText}" Style="{StaticResource MetadataValueStyle}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 日志区：操作记录 + 升级进度 -->
                <Border Grid.Row="6" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource SectionHeaderBarStyle}" Height="36" Padding="18,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource SectionAccentBarStyle}" Height="15" VerticalAlignment="Center" Margin="0,0,9,0" />
                                    <TextBlock Text="日志信息" Style="{StaticResource SectionHeaderTextStyle}" />
                                    <TextBlock Text="Log Information" FontFamily="Segoe UI" FontSize="11" Foreground="#888888" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="保存日志" Command="{Binding SaveLogCommand}" Style="{StaticResource ActionButtonStyle}" Height="26" Padding="10,0" FontSize="12" Margin="0,0,8,0" ToolTip="把当前全部日志另存为文本文件" />
                                    <Button Content="清空日志" Command="{Binding ClearLogCommand}" Style="{StaticResource ActionButtonStyle}" Height="26" Padding="10,0" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
                            <Grid Margin="18,0,18,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="文件打开、读取与升级过程记录" Style="{StaticResource LogToolbarTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{Binding LogCountText}" Style="{StaticResource LogToolbarTextStyle}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Background="#252A30">
                            <!-- 自动跟随最新行：新日志追加时滚到底，用户上滚离开底部即暂停，
                                 代码在 FirmwareUpgradeView.xaml.cs（与报文窗口同一套判定）。 -->
                            <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,8,12,8">
                                <ItemsControl ItemsSource="{Binding FirmwareLogs}" ItemTemplate="{StaticResource FirmwareLogEntryTemplate}" />
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E7EC" BorderThickness="0,1,0,0">
                            <StackPanel Margin="18,9,18,10">
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="升级进度" FontFamily="Microsoft YaHei UI" FontSize="11" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding ProgressStatusText}" FontFamily="Microsoft YaHei UI" FontSize="11" Foreground="#666666" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding ProgressPercent, StringFormat={}{0:0}%}" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="#0078D4" VerticalAlignment="Center" />
                                </Grid>
                                <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Background="#E3E8ED" Foreground="#0078D4" BorderThickness="0" />
                                <TextBlock Text="进度覆盖第一至第十五步；第十二步按设备已确认的字节数推进，新固件启动需实机验证。" FontFamily="Microsoft YaHei UI" FontSize="10" Foreground="#818A93" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 升级操作行：NAD 输入框 + 配置校验 + 开始升级（执行第一至第十五步，停止命令尚未接入取消令牌） -->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="先配置目标节点地址（NAD），再开始固件升级" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="#777777" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="NAD" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="#555555" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding NadText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="78" Height="28" VerticalContentAlignment="Center"
                                 FontFamily="Consolas, Cascadia Code, Courier New" FontSize="13"
                                 Padding="6,0" BorderBrush="#BFBFBF" BorderThickness="1"
                                 ToolTip="目标节点地址，十六进制（0x78 或 78，范围 0x00–0xFF）；非法或为空回退默认 0x78" />
                    </StackPanel>
                    <Button Grid.Column="3" Content="配置 NAD" Command="{Binding ConfigureNadCommand}" Style="{StaticResource ActionButtonStyle}" MinWidth="110" />
                    <Button Grid.Column="5" Content="开始升级" Command="{Binding StartUpgradeCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="110" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
