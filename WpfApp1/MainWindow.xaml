<mah:MetroWindow x:Class="WpfApp1.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:vm="clr-namespace:WpfApp1.ViewModels"
                 xmlns:views="clr-namespace:WpfApp1.Views"
                 xmlns:local="clr-namespace:WpfApp1"
                 mc:Ignorable="d"
                 Title="电机调试工具"
                 Height="450"
                 Width="800"
                 WindowState="Maximized">
    <mah:MetroWindow.Flyouts>
        <mah:FlyoutsControl>
            <mah:Flyout Header="串口设置"
                        Position="Right"
                        Width="330"
                        Height="440"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        Theme="Light"
                        IsModal="True"
                        IsOpen="{Binding SerialSettings.IsFlyoutOpen, Mode=TwoWay}">
                <Grid Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="基本设置" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                            <Grid Margin="0,0,0,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="34" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="串口" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding SerialSettings.AvailablePorts}"
                                          SelectedItem="{Binding SerialSettings.SelectedPort}"
                                          DisplayMemberPath="DisplayName"
                                          mah:ControlsHelper.CornerRadius="6"
                                          VerticalContentAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="波特率" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding SerialSettings.BaudRates}"
                                          SelectedItem="{Binding SerialSettings.SelectedBaudRate}"
                                          mah:ControlsHelper.CornerRadius="6"
                                          VerticalContentAlignment="Center" />
                            </Grid>

                            <TextBlock Text="高级参数" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="34" />
                                    <RowDefinition Height="34" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="数据位" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding SerialSettings.DataBitOptions}" SelectedItem="{Binding SerialSettings.SelectedDataBits}" mah:ControlsHelper.CornerRadius="6" VerticalContentAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="校验位" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SerialSettings.ParityOptions}" SelectedItem="{Binding SerialSettings.SelectedParity}" mah:ControlsHelper.CornerRadius="6" VerticalContentAlignment="Center" />
                                <TextBlock Grid.Row="2" Text="停止位" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SerialSettings.StopBitOptions}" SelectedItem="{Binding SerialSettings.SelectedStopBits}" mah:ControlsHelper.CornerRadius="6" VerticalContentAlignment="Center" />
                                <TextBlock Grid.Row="3" Text="读超时 (ms)" VerticalAlignment="Center" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SerialSettings.ReadTimeout, UpdateSourceTrigger=PropertyChanged}" mah:ControlsHelper.CornerRadius="6" VerticalContentAlignment="Center" />
                                <TextBlock Grid.Row="4" Text="写超时 (ms)" VerticalAlignment="Center" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SerialSettings.WriteTimeout, UpdateSourceTrigger=PropertyChanged}" mah:ControlsHelper.CornerRadius="6" VerticalContentAlignment="Center" />
                            </Grid>
                            <TextBlock Text="日常使用通常只需选择串口和波特率。高级参数应与设备通信协议保持一致。"
                                       Margin="0,14,0,0"
                                       FontSize="12"
                                       Foreground="#6B6B6B"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SerialSettings.ValidationMessage}"
                                       Margin="0,8,0,0"
                                       Foreground="#C42B1C"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Command="{Binding SerialSettings.CloseCommand}" MinWidth="76" Margin="0,0,8,0" mah:ControlsHelper.CornerRadius="6" />
                        <Button Content="应用设置" Command="{Binding SerialSettings.ApplyCommand}" MinWidth="88" Background="#0078D4" BorderBrush="#0078D4" Foreground="White" mah:ControlsHelper.CornerRadius="6" />
                    </StackPanel>
                </Grid>
            </mah:Flyout>
        </mah:FlyoutsControl>
    </mah:MetroWindow.Flyouts>
    <Grid Background="#F3F3F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <mah:HamburgerMenu x:Name="MainHamburgerMenu"
                           Grid.Row="0"
                           IsPaneOpen="True"
                           DisplayMode="CompactInline"
                           HamburgerWidth="35"
                           CompactPaneLength="35"
                           MinimumOpenPaneLength="35"
                           OpenPaneLength="190"
                           PanePlacement="Left"
                           PaneBackground="#FAFAFA"
                           PaneForeground="#202020"
                           ShowSelectionIndicator="True"
                           HamburgerButtonClick="MainHamburgerMenu_HamburgerButtonClick"
                           SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay}">
            <mah:HamburgerMenu.Resources>
                <DataTemplate x:Key="MenuHeaderTemplate">
                    <TextBlock Text="{Binding Label}"
                               FontSize="12"
                               FontFamily="Microsoft YaHei UI"
                               Foreground="#6B6B6B"
                               VerticalAlignment="Center"
                               Margin="16,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=IsNavigationExpanded}"
                                                 Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>

                <DataTemplate x:Key="MenuItemTemplate">
                    <Grid Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Glyph}"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="#303030"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Label}"
                                   FontSize="14"
                                   FontFamily="Microsoft YaHei UI"
                                   Foreground="#202020"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=IsNavigationExpanded}"
                                                     Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </mah:HamburgerMenu.Resources>

            <mah:HamburgerMenu.HamburgerMenuHeaderTemplate>
                <DataTemplate>
                    <Border Height="48" Background="#FFFFFF" BorderBrush="#E7E7E7" BorderThickness="0,0,0,1">
                        <TextBlock Text="导航" FontSize="14" FontFamily="Microsoft YaHei UI" Foreground="#202020" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}, Path=IsNavigationExpanded}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </DataTemplate>
            </mah:HamburgerMenu.HamburgerMenuHeaderTemplate>

            <mah:HamburgerMenu.ItemTemplate>
                <StaticResource ResourceKey="MenuItemTemplate" />
            </mah:HamburgerMenu.ItemTemplate>
            <mah:HamburgerMenu.ItemsSource>
                <Binding Path="MenuItems" />
            </mah:HamburgerMenu.ItemsSource>

            <mah:HamburgerMenu.Content>
                <ContentControl Content="{Binding CurrentViewModel}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:ActuatorDebugViewModel}">
                            <views:ActuatorDebugView />
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </mah:HamburgerMenu.Content>
        </mah:HamburgerMenu>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D7D7D7" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#C42B1C" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SerialSettings.IsConnected}" Value="True"><Setter Property="Fill" Value="#107C10" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding SerialSettings.ConnectionStatusText}" Margin="7,0,12,0" FontSize="12" Foreground="#505050" VerticalAlignment="Center" />
                    <Border Width="1" Height="14" Background="#D7D7D7" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SerialSettings.ConnectionPortDisplayText}" Margin="12,0" FontSize="12" Foreground="#6B6B6B" VerticalAlignment="Center" />
                    <Border Width="1" Height="14" Background="#D7D7D7" VerticalAlignment="Center" />
                    <TextBlock Text="报文输出窗口" Margin="12,0" FontSize="12" Foreground="#6B6B6B" VerticalAlignment="Center" />
                    <Border Width="1" Height="14" Background="#D7D7D7" VerticalAlignment="Center" />
                    <TextBlock Text="HE11" Margin="12,0" FontSize="12" Foreground="#6B6B6B" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="--" FontSize="12" Foreground="#6B6B6B" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
