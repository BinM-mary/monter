<mah:MetroWindow x:Class="WpfApp1.Views.ProtocolLogWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 Title="报文输出"
                 Width="760"
                 Height="420"
                 MinWidth="520"
                 MinHeight="260"
                 ShowInTaskbar="False"
                 ShowMinButton="False"
                 ShowMaxRestoreButton="True"
                 ShowCloseButton="True"
                 WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <TextBlock Text="发送与接收的完整协议帧"
                       FontSize="14"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right"
                    Content="清空"
                    Command="{Binding ClearCommand}"
                    Padding="14,3"
                    mah:ControlsHelper.CornerRadius="5" />
        </DockPanel>

        <ListView x:Name="LogListView"
                  Grid.Row="2"
                  ItemsSource="{Binding CommunicationLog.Entries}"
                  BorderBrush="#D7D7D7"
                  BorderThickness="1"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="时间" Width="105" DisplayMemberBinding="{Binding TimestampText}" />
                    <GridViewColumn Header="方向" Width="55" DisplayMemberBinding="{Binding DirectionText}" />
                    <GridViewColumn Header="报文（十六进制）" Width="550">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Data}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           TextWrapping="NoWrap" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="3"
                   Margin="0,8,0,0"
                   Text="通信收发管线接入后，报文将在此实时显示。"
                   FontSize="12"
                   Foreground="#6B6B6B" />
    </Grid>
</mah:MetroWindow>
