<UserControl x:Class="WpfApp1.Views.ActuatorDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#D7D7D7" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /></Style>
        <Style x:Key="CardTitleStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Microsoft YaHei UI" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#202020" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="13,0,0,0" /></Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button"><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="12,0" /><Setter Property="FontFamily" Value="Microsoft YaHei UI" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="#202020" /><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#BFBFBF" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92" /></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.55" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}"><Setter Property="Background" Value="#0078D4" /><Setter Property="BorderBrush" Value="#0078D4" /><Setter Property="Foreground" Value="#FFFFFF" /></Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}"><Setter Property="Background" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="#C42B1C" /><Setter Property="Foreground" Value="#C42B1C" /></Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Microsoft YaHei UI" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="#383838" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style x:Key="FieldControlStyle" TargetType="Control"><Setter Property="Height" Value="30" /><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" /><Setter Property="FontSize" Value="13" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
        <Style x:Key="StatusLabelStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Microsoft YaHei UI" /><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="#6B6B6B" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style x:Key="StatusValueStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="#202020" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style x:Key="ConnectionChipStyle" TargetType="Border"><Setter Property="Height" Value="32" /><Setter Property="Background" Value="#F2F2F2" /><Setter Property="BorderBrush" Value="#D5D5D5" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="10,0" /><Setter Property="Margin" Value="0,0,12,0" /></Style>
        <Style x:Key="ConnectionIndicatorStyle" TargetType="Ellipse"><Setter Property="Width" Value="8" /><Setter Property="Height" Value="8" /><Setter Property="Fill" Value="#C42B1C" /><Setter Property="VerticalAlignment" Value="Center" /><Style.Triggers><DataTrigger Binding="{Binding SerialSettings.IsConnected}" Value="True"><Setter Property="Fill" Value="#107C10" /></DataTrigger></Style.Triggers></Style>
        <Style x:Key="ConnectionStatusTextStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="#9E251A" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="7,0,10,0" /><Style.Triggers><DataTrigger Binding="{Binding SerialSettings.IsConnected}" Value="True"><Setter Property="Foreground" Value="#107C10" /></DataTrigger></Style.Triggers></Style>
    </UserControl.Resources>

    <Grid Background="#F3F3F3">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="14">
                <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="执行器调试" FontFamily="Microsoft YaHei UI" FontSize="21" FontWeight="SemiBold" Foreground="#202020" />
                            <TextBlock Text="Actuator Control &amp; Debug" FontFamily="Segoe UI" FontSize="12" Foreground="#6B6B6B" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource ConnectionChipStyle}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="1" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Ellipse Style="{StaticResource ConnectionIndicatorStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SerialSettings.ConnectionStatusText}" Style="{StaticResource ConnectionStatusTextStyle}" />
                                    <Border Grid.Column="2" Background="#D2D2D2" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding SerialSettings.ConnectionPortDisplayText}" FontSize="12" Foreground="#5C5C5C" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </Grid>
                            </Border>
                            <Button Content="串口设置" Command="{Binding SerialSettings.OpenCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="{Binding SerialSettings.ConnectionButtonText}" Command="{Binding SerialSettings.ToggleConnectionCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="420" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.15*" MinWidth="500" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource CardStyle}">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border BorderBrush="#E7E7E7" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal"><Border Width="3" Background="#0078D4" /><TextBlock Text="读取设备信息" Style="{StaticResource CardTitleStyle}" /></StackPanel></Border>
                                <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="14">
                                    <Button Content="读取初始化行程" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,8" /><Button Content="读取固件版本" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,8" />
                                    <Button Content="读取软硬件版本" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" /><Button Content="读取电压和温度参数" Style="{StaticResource ActionButtonStyle}" />
                                </UniformGrid>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Border BorderBrush="#E7E7E7" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal"><Border Width="3" Background="#0078D4" /><TextBlock Text="参数配置" Style="{StaticResource CardTitleStyle}" /></StackPanel></Border>
                                <StackPanel Grid.Row="1" Margin="14">
                                    <Grid Height="28" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="38" Height="20" Background="#B8B8B8" CornerRadius="10" VerticalAlignment="Center"><Ellipse Width="16" Height="16" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="2" /></Border><TextBlock Grid.Column="1" Text="使能参数写入" Style="{StaticResource FieldLabelStyle}" /><TextBlock Grid.Column="2" Text="开启后可修改并写入设备参数" FontSize="12" Foreground="#6B6B6B" VerticalAlignment="Center" Margin="12,0,0,0" /></Grid>
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="38" /><RowDefinition Height="38" /><RowDefinition Height="38" /><RowDefinition Height="38" /><RowDefinition Height="38" /><RowDefinition Height="38" /><RowDefinition Height="38" /><RowDefinition Height="38" /><RowDefinition Height="38" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="112" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="更改 NAD" Style="{StaticResource FieldLabelStyle}" /><Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="68" /></Grid.ColumnDefinitions><ComboBox SelectedIndex="0" Style="{StaticResource FieldControlStyle}"><ComboBoxItem Content="0x26" /><ComboBoxItem Content="0x27" /></ComboBox><Button Grid.Column="1" Content="写入" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0" /></Grid>
                                        <TextBlock Grid.Row="1" Text="当前 NAD" Style="{StaticResource FieldLabelStyle}" /><Grid Grid.Row="1" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="68" /></Grid.ColumnDefinitions><TextBox Text="0x63" IsEnabled="False" Style="{StaticResource FieldControlStyle}" /><Button Grid.Column="1" Content="读取" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0" /></Grid>
                                        <TextBlock Grid.Row="2" Text="设备休眠" Style="{StaticResource FieldLabelStyle}" /><Grid Grid.Row="2" Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="68" /></Grid.ColumnDefinitions><ComboBox IsEnabled="False" SelectedIndex="0" Style="{StaticResource FieldControlStyle}"><ComboBoxItem Content="关闭" /><ComboBoxItem Content="开启" /></ComboBox><Button Grid.Column="1" Content="保存" IsEnabled="False" Style="{StaticResource ActionButtonStyle}" Margin="8,0,0,0" /></Grid>
                                        <TextBlock Grid.Row="3" Text="电机运行方向" Style="{StaticResource FieldLabelStyle}" /><ComboBox Grid.Row="3" Grid.Column="1" IsEnabled="False" SelectedIndex="0" Style="{StaticResource FieldControlStyle}"><ComboBoxItem Content="CW（顺时针）" /><ComboBoxItem Content="CCW（逆时针）" /></ComboBox>
                                        <TextBlock Grid.Row="4" Text="退步角度 / 0.01°" Style="{StaticResource FieldLabelStyle}" /><TextBox Grid.Row="4" Grid.Column="1" Text="0" IsEnabled="False" Style="{StaticResource FieldControlStyle}" />
                                        <TextBlock Grid.Row="5" Text="缓启动" Style="{StaticResource FieldLabelStyle}" /><ComboBox Grid.Row="5" Grid.Column="1" IsEnabled="False" SelectedIndex="0" Style="{StaticResource FieldControlStyle}"><ComboBoxItem Content="关闭" /><ComboBoxItem Content="开启" /></ComboBox>
                                        <TextBlock Grid.Row="6" Text="缓停止" Style="{StaticResource FieldLabelStyle}" /><ComboBox Grid.Row="6" Grid.Column="1" IsEnabled="False" SelectedIndex="0" Style="{StaticResource FieldControlStyle}"><ComboBoxItem Content="关闭" /><ComboBoxItem Content="开启" /></ComboBox>
                                        <TextBlock Grid.Row="7" Text="堵转配置" Style="{StaticResource FieldLabelStyle}" /><ComboBox Grid.Row="7" Grid.Column="1" IsEnabled="False" SelectedIndex="0" Style="{StaticResource FieldControlStyle}"><ComboBoxItem Content="开启" /><ComboBoxItem Content="关闭" /></ComboBox>
                                        <TextBlock Grid.Row="8" Text="保持电流阈值" Style="{StaticResource FieldLabelStyle}" /><ComboBox Grid.Row="8" Grid.Column="1" IsEnabled="False" SelectedIndex="0" Style="{StaticResource FieldControlStyle}"><ComboBoxItem Content="0x00 - 28mA" /><ComboBoxItem Content="0x01 - 56mA" /></ComboBox>
                                        <TextBlock Grid.Row="9" Text="保持时间 (ms)" Style="{StaticResource FieldLabelStyle}" /><TextBox Grid.Row="9" Grid.Column="1" Text="0" IsEnabled="False" Style="{StaticResource FieldControlStyle}" />
                                    </Grid>
                                    <Border Background="#E9F3FB" BorderBrush="#C9E1F4" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,10"><TextBlock Text="提示：为避免误操作，需先开启“使能参数写入”后才能修改设备运行参数。" TextWrapping="Wrap" FontSize="12" Foreground="#38607E" /></Border>
                                    <Button Content="初始化使能" Style="{StaticResource ActionButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource CardStyle}"><Grid><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border BorderBrush="#E7E7E7" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal"><Border Width="3" Background="#0078D4" /><TextBlock Text="电机控制" Style="{StaticResource CardTitleStyle}" /></StackPanel></Border><StackPanel Grid.Row="1" Margin="14"><RadioButton Content="设置目标位置" IsChecked="False" FontSize="13" Foreground="#202020" /><Grid Margin="22,8,0,14" IsEnabled="False"><Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions><TextBlock Text="目标位置" Style="{StaticResource FieldLabelStyle}" /><Slider Grid.Column="1" Minimum="0" Maximum="1000" Value="0" VerticalAlignment="Center" /><TextBox Grid.Column="2" Text="0" Style="{StaticResource FieldControlStyle}" Margin="10,0,0,0" /></Grid><RadioButton Content="固定位置控制" IsChecked="True" FontSize="13" Foreground="#202020" Margin="0,0,0,10" /><UniformGrid Columns="2" Rows="2" Margin="22,0,0,8"><Button Content="CLOSE" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,8" /><Button Content="OPEN1" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,8" /><Button Content="OPEN2" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" /><Button Content="OPEN3" Style="{StaticResource ActionButtonStyle}" /></UniformGrid><Button Content="STOP" Style="{StaticResource DangerButtonStyle}" Margin="22,0,0,0" /></StackPanel></Grid></Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border BorderBrush="#E7E7E7" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal"><Border Width="3" Background="#0078D4" /><TextBlock Text="设备状态" Style="{StaticResource CardTitleStyle}" /></StackPanel></Border><Grid Grid.Row="1" Margin="14"><Grid.RowDefinitions><RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" /><RowDefinition Height="30" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="初始化状态" Style="{StaticResource StatusLabelStyle}" /><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="#107C10" VerticalAlignment="Center" /><TextBlock Text=" READY" Style="{StaticResource StatusValueStyle}" Foreground="#107C10" /></StackPanel><TextBlock Grid.Column="2" Text="开路故障" Style="{StaticResource StatusLabelStyle}" /><TextBlock Grid.Column="3" Text="正常" Style="{StaticResource StatusValueStyle}" Foreground="#107C10" />
                            <TextBlock Grid.Row="1" Text="初始化步数" Style="{StaticResource StatusLabelStyle}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="0" Style="{StaticResource StatusValueStyle}" /><TextBlock Grid.Row="1" Grid.Column="2" Text="短路故障" Style="{StaticResource StatusLabelStyle}" /><TextBlock Grid.Row="1" Grid.Column="3" Text="正常" Style="{StaticResource StatusValueStyle}" Foreground="#107C10" />
                            <TextBlock Grid.Row="2" Text="退步度数" Style="{StaticResource StatusLabelStyle}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="0" Style="{StaticResource StatusValueStyle}" /><TextBlock Grid.Row="2" Grid.Column="2" Text="马达故障" Style="{StaticResource StatusLabelStyle}" /><TextBlock Grid.Row="2" Grid.Column="3" Text="正常" Style="{StaticResource StatusValueStyle}" Foreground="#107C10" />
                            <TextBlock Grid.Row="3" Text="软件版本" Style="{StaticResource StatusLabelStyle}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="V1.0.0" Style="{StaticResource StatusValueStyle}" /><TextBlock Grid.Row="3" Grid.Column="2" Text="欠压故障" Style="{StaticResource StatusLabelStyle}" /><TextBlock Grid.Row="3" Grid.Column="3" Text="正常" Style="{StaticResource StatusValueStyle}" Foreground="#107C10" />
                            <TextBlock Grid.Row="4" Text="硬件版本" Style="{StaticResource StatusLabelStyle}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="Rev.A" Style="{StaticResource StatusValueStyle}" /><TextBlock Grid.Row="4" Grid.Column="2" Text="过压故障" Style="{StaticResource StatusLabelStyle}" /><TextBlock Grid.Row="4" Grid.Column="3" Text="正常" Style="{StaticResource StatusValueStyle}" Foreground="#107C10" />
                            <TextBlock Grid.Row="5" Text="装配类型" Style="{StaticResource StatusLabelStyle}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="Standard" Style="{StaticResource StatusValueStyle}" /><TextBlock Grid.Row="5" Grid.Column="2" Text="过温故障" Style="{StaticResource StatusLabelStyle}" /><TextBlock Grid.Row="5" Grid.Column="3" Text="正常" Style="{StaticResource StatusValueStyle}" Foreground="#107C10" />
                            <TextBlock Grid.Row="6" Text="当前电压" Style="{StaticResource StatusLabelStyle}" /><TextBlock Grid.Row="6" Grid.Column="1" Text="12.1 V" Style="{StaticResource StatusValueStyle}" /><TextBlock Grid.Row="6" Grid.Column="2" Text="堵转故障" Style="{StaticResource StatusLabelStyle}" /><TextBlock Grid.Row="6" Grid.Column="3" Text="正常" Style="{StaticResource StatusValueStyle}" Foreground="#107C10" />
                            <TextBlock Grid.Row="7" Text="当前温度" Style="{StaticResource StatusLabelStyle}" /><TextBlock Grid.Row="7" Grid.Column="1" Text="28.6 ℃" Style="{StaticResource StatusValueStyle}" />
                        </Grid></Grid></Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="92" /></Grid.RowDefinitions><Border BorderBrush="#E7E7E7" BorderThickness="0,0,0,1"><StackPanel Orientation="Horizontal"><Border Width="3" Background="#0078D4" /><TextBlock Text="当前位置" Style="{StaticResource CardTitleStyle}" /></StackPanel></Border><TextBlock Grid.Row="1" Text="0" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="42" FontWeight="Light" Foreground="#202020" /></Grid></Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
